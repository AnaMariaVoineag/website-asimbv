# ==============================================================================
# ASIMBV DOCKER CONFIGURATION - ENVIRONMENT VARIABLES
# Copy this file to '.env' before running for the first time:
#   cp .env.example .env
# ==============================================================================

# --- Docker Compose Project Name ---
COMPOSE_PROJECT_NAME=asimbv-website

# --- PostgreSQL 16 ---
POSTGRES_DB=asimbv_db
POSTGRES_USER=asimbv_user
POSTGRES_PASSWORD=asimbv_secret_password_2026
POSTGRES_PORT=5432

# --- Adminer (Database Web UI) ---
ADMINER_PORT=8080

# --- Backend (ASP.NET Core Web API) ---
BACKEND_PORT=5197
ASPNETCORE_ENVIRONMENT=Development
# Account of the admin dashboard (/admin). Sign in with this email and password.
# Use a password of at least 12 characters, NOT the Gmail password of this address.
# While ADMIN_PASSWORD is empty (or too short), admin login is disabled.
ADMIN_EMAIL=asociatiainfomatebv@gmail.com
ADMIN_PASSWORD=

# --- Frontend (React + Vite) ---
FRONTEND_PORT=5173

