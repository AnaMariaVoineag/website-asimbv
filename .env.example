# ==============================================================================
# ASIMBV DOCKER CONFIGURATION - ENVIRONMENT VARIABLES
# Copy this file to '.env' before running for the first time:
#   cp .env.example .env
# ==============================================================================

# --- Docker Compose Project Name ---
COMPOSE_PROJECT_NAME=asimbv-website

# --- PostgreSQL 16 ---
POSTGRES_DB=asimbv_db
POSTGRES_USER=asimbv_user
POSTGRES_PASSWORD=asimbv_secret_password_2026
POSTGRES_PORT=5432

# --- Adminer (Database Web UI) ---
ADMINER_PORT=8080

# --- Backend (ASP.NET Core Web API) ---
BACKEND_PORT=5197
ASPNETCORE_ENVIRONMENT=Development
# Sent as the X-Admin-Key header to read contact messages and newsletter subscribers.
# Generate one with: openssl rand -hex 32
# While empty, those admin endpoints reject every request.
ADMIN_API_KEY=

# --- Frontend (React + Vite) ---
FRONTEND_PORT=5173

