    {
      "key": "baseUrl",
      "value": "http://localhost:5197"
    },
    {
      "key": "adminKey",
      "value": ""
    },
    {
      "key": "qaEventId",
      "value": ""
    },
    {
      "key": "qaUnsubToken",
      "value": ""
    }
  ],
